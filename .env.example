GROQ_API_KEY=your_groq_api_key_here
PORT=3000
# Comma-separated published Chrome extension IDs allowed to call the API. Leave unset
# in dev (accepts any chrome-extension:// origin); set before shipping publicly.
ALLOWED_EXTENSION_IDS=
# Semantic half of /v1/ask-repo's hybrid retrieval, via @huggingface/transformers
# (local ONNX model). Leave false (or unset) on Render's free tier — that package's
# native runtime doesn't fit its 512MB memory limit alongside the rest of the API.
# false/unset: BM25 lexical retrieval only, and the package is never even imported.
# true: hybrid BM25 + embedding-based retrieval.
ENABLE_LOCAL_EMBEDDINGS=false
