# GitGuide API configuration. Copy to .env for local development (`npm run dev:api`).
# On Render, set these in the service's Environment settings instead (see render.yaml).

# Required. Server-side only — never put this in the extension.
GROQ_API_KEY=your_groq_api_key_here
PORT=3000

# Recommended. A fine-grained token with NO repository permissions (public data only)
# raises GitHub's limit from 60 to 5,000 requests/hour. The server refuses private
# repositories even if a token could read them.
GITHUB_TOKEN=

# Published Chrome Web Store extension id(s), comma-separated. Leave empty in local dev.
# This is a browser Origin check only — not authentication.
ALLOWED_EXTENSION_IDS=

# Reverse-proxy hops in front of the app (Render: verify with the `xff` log field).
TRUST_PROXY_HOPS=1

# Hybrid (BM25 + local embeddings) retrieval. Needs >512MB RAM; false = keyword (BM25) only.
ENABLE_LOCAL_EMBEDDINGS=false

# Spending and capacity safeguards (in-memory, per instance).
MAX_CONCURRENT_AI_REQUESTS=6
AI_QUEUE_TIMEOUT_MS=15000
DAILY_AI_REQUEST_BUDGET=3000
MAX_CONCURRENT_INDEX_JOBS=2
MAX_CONCURRENT_BACKGROUND_JOBS=1
GITHUB_TIMEOUT_MS=10000
GROQ_TIMEOUT_MS=60000

# Optional model overrides.
# GROQ_MODEL_LARGE=llama-3.3-70b-versatile
# GROQ_MODEL_SMALL=llama-3.1-8b-instant
