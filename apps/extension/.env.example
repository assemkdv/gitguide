# Copy to .env.development.local (local) or edit .env.production (release).
# VITE_API_URL: origin of the GitGuide API, no trailing path. Release builds require https.
VITE_API_URL=http://localhost:3000
# VITE_PRIVACY_POLICY_URL: public URL of the privacy policy.
VITE_PRIVACY_POLICY_URL=https://github.com/assemkdv/gitguide/blob/main/docs/PRIVACY.md
