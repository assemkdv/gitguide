# Loaded by the release build (`npm run build:extension`). Not a secret: this is the
# public base URL of the deployed API. The manifest's host permission is derived from it,
# and the build fails unless it is an https origin (no path, not localhost).
VITE_API_URL=https://gitguide-api.onrender.com
# Public URL of the privacy policy shown in the panel and the Web Store listing.
VITE_PRIVACY_POLICY_URL=https://github.com/assemkdv/gitguide/blob/main/docs/PRIVACY.md
