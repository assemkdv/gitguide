{
  "name": "gitguide",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/extension"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "build:extension": "npm run build --workspace=apps/extension",
    "lint": "eslint apps/api/src apps/extension/src",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/extension"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  }
}
