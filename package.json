{
  "name": "gitguide",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/extension"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "build:api": "npm run build --workspace=apps/api",
    "build:extension": "npm run build --workspace=apps/extension",
    "build:extension:dev": "npm run build:dev --workspace=apps/extension",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "lint": "eslint apps/api/src apps/extension/src",
    "typecheck": "tsc --noEmit -p apps/api && tsc --noEmit -p apps/extension",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/extension",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
